# Copie para .env e preencha. O .env não vai para o git.

# ─── Banco ───
# Docker Compose (local ou VPS): usuário/senha/base precisam bater com o compose.
POSTGRES_USER=gestao
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gestao_restaurante
POSTGRES_PORT=5432

# String de conexão usada pela aplicação e pelas migrations.
# Com o Docker Compose acima:
DATABASE_URL="postgresql://gestao:troque-esta-senha@localhost:5432/gestao_restaurante?schema=public"

# Postgres de verdade, para os testes e para medir o RLS. O `prisma dev` não
# serve: ele roda como superusuário, e superusuário atravessa toda política —
# o RLS pareceria ligado sem estar valendo.
# Se a senha tiver @ : / # ou %, codifique (@ vira %40).
TEST_DATABASE_URL="postgresql://postgres:senha@localhost:5432/gestao_teste"

# Role da aplicação sob RLS, criada por `npm run rls:aplicar`. É por ela que a
# aplicação deve conectar em produção — nunca pelo superusuário acima.
RLS_DATABASE_URL="postgresql://app_gestao:senha@localhost:5432/gestao_teste"

# Role que atravessa restaurantes (BYPASSRLS). Duas perguntas do sistema
# precisam dela, e só elas: de quem é este subdomínio, e de que unidade é este
# token de impressão. Sem ela, sob RLS, nem a tela de login abriria.
# Em desenvolvimento pode ficar vazia — a DATABASE_URL já serve.
DATABASE_URL_SEM_RLS=

# ─── App ───
# Segredo de sessão: gere com  openssl rand -base64 32
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
